<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <!-- Copied from production for dev parity; the suite must not see them. -->
        <env name="CITATIONS_M365_CLIENT_ID" value=""/>
        <env name="CITATIONS_M365_CLIENT_SECRET" value=""/>
        <env name="CITATIONS_M365_TENANT_ID" value=""/>
        <!-- The GBP description proposal reads Google and Gemini for real; the local .env would make it live under test. -->
        <env name="SEO_AUTOPILOT_GBP_DESCRIPTION_ENABLED" value="false"/>
        <!-- gs.construction's real Google grant (the shared sign-in client, its refresh token and listing) is in the
             local .env for dev parity. With it the suite called Google's token endpoint for real — an image saved in a
             test queued the site's own GBP upload. A test that needs Google sets config() and fakes Http itself. -->
        <env name="GOOGLE_OAUTH_CLIENT_ID" value=""/>
        <env name="GOOGLE_OAUTH_CLIENT_SECRET" value=""/>
        <env name="GOOGLE_OAUTH_PROJECT_ID" value=""/>
        <env name="GOOGLE_BUSINESS_PROFILE_CLIENT_ID" value=""/>
        <env name="GOOGLE_BUSINESS_PROFILE_CLIENT_SECRET" value=""/>
        <env name="GOOGLE_BUSINESS_PROFILE_REFRESH_TOKEN" value=""/>
        <env name="GOOGLE_BUSINESS_PROFILE_ACCOUNT_ID" value=""/>
        <env name="GOOGLE_BUSINESS_PROFILE_LOCATION_ID" value=""/>
        <env name="GOOGLE_BUSINESS_PROFILE_PLACE_ID" value=""/>
        <env name="GOOGLE_SEARCH_CONSOLE_CLIENT_ID" value=""/>
        <env name="GOOGLE_SEARCH_CONSOLE_CLIENT_SECRET" value=""/>
        <env name="GOOGLE_SEARCH_CONSOLE_REFRESH_TOKEN" value=""/>
        <!-- Every other real third-party credential the local .env carries (it is a copy of production's). With them
             the suite called Gemini for real from ~30 tests (image alt text, captions, review triage) and could reach
             OpenAI, Places, PageSpeed, Bing, Clarity, DataForSEO, IndexNow, Cloudflare, Forge, Meta, hive and the GA4
             measurement endpoint — slow, flaky under parallel runs, and live side effects. A test that needs one of
             these sets config() itself and fakes Http. -->
        <env name="GOOGLE_GEMINI_API_KEY" value=""/>
        <env name="GOOGLE_PLACES_API_KEY" value=""/>
        <env name="GOOGLE_MAPS_BROWSER_KEY" value=""/>
        <env name="GOOGLE_PAGESPEED_API_KEY" value=""/>
        <env name="GOOGLE_MEASUREMENT_API_SECRET" value=""/>
        <env name="OPENAI_API_KEY" value=""/>
        <env name="ASSEMBLYAI_API_KEY" value=""/>
        <env name="SERPAPI_KEY" value=""/>
        <env name="BING_WEBMASTER_API_KEY" value=""/>
        <env name="MICROSOFT_CLARITY_API_TOKEN" value=""/>
        <env name="DATAFORSEO_LOGIN" value=""/>
        <env name="DATAFORSEO_PASSWORD" value=""/>
        <env name="INDEXNOW_ENABLED" value="false"/>
        <env name="INDEXNOW_KEY" value=""/>
        <env name="CLOUDFLARE_API_TOKEN" value=""/>
        <env name="FORGE_API_TOKEN" value=""/>
        <env name="META_APP_ID" value=""/>
        <env name="META_APP_SECRET" value=""/>
        <env name="NYLAS_API_KEY" value=""/>
        <env name="HIVE_API_TOKEN" value=""/>
        <env name="ANTICAPTCHA_API_KEY" value=""/>
        <env name="TWOCAPTCHA_API_KEY" value=""/>
        <env name="EMAIL_LEADS_ENABLED" value="false"/>
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
        <!-- GeoapifyService uses a raw Guzzle client, not the Http facade, so
             Http::fake() cannot intercept it. Blanking the key here is the
             hard backstop: GeoapifyService::apiKey === '' short-circuits
             before any network call, for every test — including ones that
             exercise LeadAddressCompleter without explicitly mocking
             GeoapifyService. Tests that need real completer behaviour mock
             GeoapifyService itself instead. -->
        <env name="GEOAPIFY_API_KEY" value=""/>
    </php>
</phpunit>
